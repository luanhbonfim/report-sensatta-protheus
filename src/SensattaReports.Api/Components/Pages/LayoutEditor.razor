@page "/admin/layout/{codigo}"
@implements IAsyncDisposable
@inject IReportRepository Repo
@inject ReportFileStore Store
@inject ToastService Toasts
@inject IJSRuntime JS
@using Microsoft.JSInterop
@using SensattaReports.ReportBuilder.Model

<div class="editor-toolbar">
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-light border" href="/admin/relatorios" title="Voltar à lista"><i class="bi bi-arrow-left"></i></a>
        <div>
            <div class="fw-bold lh-1">Editar layout</div>
            <div class="text-muted small lh-1">@(nome ?? codigo)</div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="btn-group btn-group-sm" role="group">
            <button class="btn btn-outline-secondary" @onclick="() => Zoom(-1)" disabled="@(scale <= 2.5)" title="Diminuir"><i class="bi bi-zoom-out"></i></button>
            <button class="btn btn-outline-secondary" @onclick="AjustarLargura" title="Ajustar à largura"><i class="bi bi-arrows-angle-expand"></i></button>
            <button class="btn btn-outline-secondary" @onclick="() => Zoom(1)" disabled="@(scale >= 14.0)" title="Aumentar"><i class="bi bi-zoom-in"></i></button>
        </div>
        <button class="btn btn-sm btn-light border" @onclick="Desfazer" disabled="@(historico.Count == 0)" title="Desfazer o último ajuste"><i class="bi bi-arrow-90deg-left me-1"></i>Desfazer</button>
        <button class="btn btn-sm btn-light border" @onclick="AbrirJson" title="Editar o JSON"><i class="bi bi-braces me-1"></i>JSON</button>
        <button class="btn btn-sm btn-light border text-danger" @onclick="ResetarTudo" disabled="@(overrides.Count == 0)" title="Descartar todos os ajustes"><i class="bi bi-arrow-counterclockwise"></i></button>
        <button class="btn btn-sm btn-outline-primary" @onclick="AbrirPreview"><i class="bi bi-eye me-1"></i>Pré-visualizar</button>
        <button class="btn btn-sm btn-primary" @onclick="Salvar"><i class="bi bi-save me-1"></i>Salvar</button>
    </div>
</div>

@if (tpl is null)
{
    <div class="alert alert-light border m-3">@(erro ?? "Carregando…")</div>
}
else
{
    <div class="editor-grid">
        <div class="editor-main">
            <div class="layout-canvas" @ref="canvas">
                @foreach (var sec in Secoes())
                {
                    <div class="band-card">
                        <div class="band-head">@sec.Label <span class="band-dim">@F(sec.Band.HeightMm)&nbsp;mm</span></div>
                        <div class="band" style="width:@Px(tpl.ContentWidthMm)px; height:@Px(Math.Max(sec.Band.HeightMm, 6))px;">
                            @foreach (var el in sec.Band.Elements)
                            {
                                var b = Eff(el);
                                <div class="rp-field @(el is RbLine ? "is-line" : "") @(b.Hidden ? "is-hidden" : "") @(el.Name == selecionado ? "sel" : "")"
                                     data-name="@el.Name"
                                     style="left:@Px(b.Left)px; top:@Px(b.Top)px; width:@Px(Math.Max(b.Width,2))px; height:@Px(Math.Max(b.Height,2))px;"
                                     title="@el.Name"
                                     @onclick="() => Selecionar(el.Name)">
                                    <span class="rp-field-txt">@Rotulo(el)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="text-muted small mt-2 px-1">
                <i class="bi bi-hand-index me-1"></i>Arraste um campo para mover · clique para selecionar e ajustar à direita.
            </div>
        </div>

        <aside class="editor-side">
            <div class="card prop-card">
                <div class="card-header py-2"><i class="bi bi-sliders me-1"></i>Campo selecionado</div>
                <div class="card-body">
                    @if (sel is not { } s)
                    {
                        <div class="text-muted small text-center py-4">
                            <i class="bi bi-cursor d-block fs-4 mb-2 opacity-50"></i>
                            Clique num campo no layout para ajustá-lo.
                        </div>
                    }
                    else
                    {
                        var b = Eff(s);
                        <div class="fw-semibold">@Rotulo(s)</div>
                        <div class="text-muted small font-monospace mb-3">@s.Name</div>

                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-0">Esquerda</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.5" class="form-control" value="@F(b.Left)" @onchange="e => SetPos(e, 'L')" />
                                    <span class="input-group-text">mm</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-0">Topo</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.5" class="form-control" value="@F(b.Top)" @onchange="e => SetPos(e, 'T')" />
                                    <span class="input-group-text">mm</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-0">Largura</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.5" class="form-control" value="@F(b.Width)" @onchange="e => SetPos(e, 'W')" />
                                    <span class="input-group-text">mm</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-0">Altura</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.5" class="form-control" value="@F(b.Height)" @onchange="e => SetPos(e, 'H')" />
                                    <span class="input-group-text">mm</span>
                                </div>
                            </div>
                        </div>

                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" id="chkHide" checked="@b.Hidden" @onchange="ToggleHidden" />
                            <label class="form-check-label small" for="chkHide">Ocultar este campo</label>
                        </div>

                        @if (overrides.ContainsKey(s.Name))
                        {
                            <button class="btn btn-sm btn-outline-secondary w-100 mt-3" @onclick="() => ResetarCampo(s.Name)">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Voltar este campo ao original
                            </button>
                        }
                    }
                </div>
            </div>
        </aside>
    </div>
}

@if (previewAberto)
{
    <div class="preview-overlay" @onclick="FecharPreview">
        <div class="preview-dialog" @onclick="() => {}" @onclick:stopPropagation="true">
            <div class="preview-dialog-head">
                <span class="fw-semibold"><i class="bi bi-file-earmark-pdf me-1"></i>Pré-visualização — @(nome ?? codigo)</span>
                <div class="d-flex align-items-end gap-2 flex-wrap ms-auto">
                    @foreach (var p in parametros)
                    {
                        <div>
                            <label class="form-label small text-muted mb-0 d-block lh-1">@p</label>
                            <input class="form-control form-control-sm" style="width:140px" placeholder="@p"
                                   @bind:get="GetTeste(p)" @bind:set="v => SetTeste(p, v)" />
                        </div>
                    }
                    <button class="btn btn-sm btn-primary" @onclick="AtualizarPreview"><i class="bi bi-arrow-repeat me-1"></i>Gerar</button>
                    @if (previewUrl is not null)
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@previewUrl" target="_blank" title="Abrir em nova aba"><i class="bi bi-box-arrow-up-right"></i></a>
                    }
                    <button class="btn btn-sm btn-light border" @onclick="FecharPreview" title="Fechar"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
            <div class="preview-dialog-body">
                @if (previewUrl is not null)
                {
                    <iframe src="@previewUrl" class="preview-frame"></iframe>
                }
                else
                {
                    <div class="text-muted text-center p-5">
                        Preencha os valores e clique em <b>Gerar</b>.
                        <div class="small mt-1">O preview mostra o que está <b>salvo</b> — salve os ajustes antes.</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<Modal @bind-Visible="jsonVisible" Title="JSON do layout (report.layout.json)">
    <p class="text-muted small">A chave é o <b>nome</b> do campo; cada medida (<code>leftMm</code>, <code>topMm</code>, <code>widthMm</code>, <code>heightMm</code>, <code>hidden</code>) é opcional.</p>
    <textarea class="form-control font-monospace" rows="16" @bind="jsonText" spellcheck="false"></textarea>
    @if (jsonErro is not null)
    {
        <div class="alert alert-danger py-2 small mt-2 mb-0">@jsonErro</div>
    }
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-outline-secondary" @onclick="() => jsonVisible = false">Cancelar</button>
        <button class="btn btn-primary" @onclick="AplicarJson"><i class="bi bi-check2 me-1"></i>Aplicar</button>
    </div>
</Modal>

<style>
    .editor-toolbar { position:sticky; top:0; z-index:20; display:flex; justify-content:space-between; align-items:center;
                      gap:12px; flex-wrap:wrap; background:#fff; border:1px solid #e5e7eb; border-radius:.6rem;
                      padding:10px 14px; margin-bottom:14px; box-shadow:0 1px 3px rgba(0,0,0,.05); }
    .editor-grid { display:grid; grid-template-columns:1fr 320px; gap:16px; align-items:start; }
    @@media (max-width:991px){ .editor-grid { grid-template-columns:1fr; } }
    .editor-side { position:sticky; top:72px; }
    .layout-canvas { background:#f4f5f7; border:1px solid #e5e7eb; border-radius:.6rem; padding:16px;
                     max-height:74vh; overflow:auto; }
    .band-card { background:#fff; border:1px solid #e5e7eb; border-radius:.45rem; margin-bottom:14px; overflow:hidden;
                 box-shadow:0 1px 2px rgba(0,0,0,.04); }
    .band-head { font-size:.72rem; font-weight:700; letter-spacing:.02em; text-transform:uppercase; color:#6b0d0d;
                 background:#faf6f6; border-bottom:1px solid #f0e3e3; padding:5px 10px; display:flex; justify-content:space-between; }
    .band-dim { color:#9aa0a6; font-weight:600; }
    .band { position:relative; margin:10px; background:
            linear-gradient(#eef0f3 1px, transparent 1px) 0 0/100% 10px,
            linear-gradient(90deg,#eef0f3 1px, transparent 1px) 0 0/10px 100%, #fff;
            border:1px solid #eceef1; border-radius:3px; }
    .rp-field { position:absolute; box-sizing:border-box; border:1px solid #9bb3d4; border-radius:3px;
                background:rgba(13,110,253,.08); color:#243b53; font-size:11px; line-height:1.1; overflow:hidden;
                cursor:grab; user-select:none; padding:2px 4px; white-space:nowrap; transition:box-shadow .08s,border-color .08s; }
    .rp-field:hover { border-color:#0d6efd; background:rgba(13,110,253,.16); box-shadow:0 1px 4px rgba(13,110,253,.25); z-index:4; }
    .rp-field.sel { border-color:#d20a11; background:rgba(210,10,17,.12); box-shadow:0 0 0 2px rgba(210,10,17,.3); z-index:6; }
    .rp-field.is-line { background:#9aa0a6; border-color:#9aa0a6; }
    .rp-field.is-hidden { opacity:.4; border-style:dashed; }
    .rp-field.rp-dragging { cursor:grabbing; opacity:.85; z-index:12; }
    .rp-field-txt { pointer-events:none; }
    .prop-card { border:1px solid #e5e7eb; box-shadow:0 1px 3px rgba(0,0,0,.05); }
    .preview-overlay { position:fixed; inset:0; z-index:1080; background:rgba(15,23,42,.55);
                       display:flex; align-items:center; justify-content:center; padding:2.5vh 2vw; }
    .preview-dialog { background:#fff; border-radius:.7rem; width:94vw; max-width:1100px; height:95vh;
                      display:flex; flex-direction:column; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,.4); }
    .preview-dialog-head { display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding:10px 16px;
                           border-bottom:1px solid #e5e7eb; background:#f8f9fa; }
    .preview-dialog-body { flex:1; min-height:0; background:#525659; }
    .preview-frame { width:100%; height:100%; border:0; display:block; }
</style>

@code {
    [Parameter] public string codigo { get; set; } = "";

    double scale = 4.5; // px por mm (ajustável pelo zoom)

    RbTemplate? tpl;
    string? nome;
    string? erro;
    string? selecionado;
    string? previewUrl;
    bool previewAberto;

    readonly Dictionary<string, ElementOverride> overrides = new(StringComparer.OrdinalIgnoreCase);
    readonly Stack<Dictionary<string, ElementOverride>> historico = new(); // p/ desfazer
    List<string> parametros = new();
    readonly Dictionary<string, string> testeValores = new();

    bool jsonVisible;
    string jsonText = "";
    string? jsonErro;

    ElementReference canvas;
    IJSObjectReference? module;
    DotNetObjectReference<LayoutEditor>? selfRef;

    RbElement? sel => tpl is null || selecionado is null ? null : Todos().FirstOrDefault(e => e.Name == selecionado);

    protected override async Task OnInitializedAsync()
    {
        var def = await Repo.GetByCodigoAsync(codigo);
        if (def is null) { erro = "Relatório não encontrado."; return; }

        nome = Store.GetName(codigo) ?? codigo;
        tpl = RbTemplateLoader.Load(def.TemplateRtm);
        foreach (var kv in Store.GetLayout(codigo)) overrides[kv.Key] = kv.Value;
        parametros = def.Parametros.Select(p => p.Name).ToList();
        foreach (var p in parametros) testeValores[p] = "";
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first && tpl is not null)
        {
            try
            {
                // ?v= evita o navegador usar uma versão antiga do módulo em cache
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./layout-editor.js?v=4");
                selfRef = DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("enableDrag", canvas, selfRef);
                await AjustarLargura(); // zoom inicial = cabe na largura (sem scroll lateral)
            }
            catch
            {
                // sem o arrastar o editor ainda funciona pelos campos numéricos
            }
        }
    }

    async Task AjustarLargura()
    {
        if (module is null || tpl is null) return;
        var w = await module.InvokeAsync<double>("clientWidth", canvas);
        if (w > 80)
        {
            // desconta padding do canvas + margem/bordas da banda, p/ não sobrar scroll lateral
            scale = Math.Clamp((w - 56) / tpl.ContentWidthMm, 2.5, 14.0);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnFieldMoved(string name, double leftPx, double topPx)
    {
        Snapshot();
        Merge(name, o => o with { LeftMm = Round(leftPx / scale), TopMm = Round(topPx / scale) });
        selecionado = name;
        return InvokeAsync(StateHasChanged);
    }

    void Zoom(double delta) => scale = Math.Clamp(scale + delta, 2.5, 14.0);

    void AbrirPreview() => previewAberto = true;
    void FecharPreview() => previewAberto = false;

    // ---- desfazer ----
    void Snapshot() => historico.Push(new Dictionary<string, ElementOverride>(overrides, StringComparer.OrdinalIgnoreCase));

    void Desfazer()
    {
        if (historico.Count == 0) return;
        var anterior = historico.Pop();
        overrides.Clear();
        foreach (var kv in anterior) overrides[kv.Key] = kv.Value;
    }

    // ---- bandas / elementos ----
    record Secao(string Label, RbBand Band);

    IEnumerable<Secao> Secoes()
    {
        if (tpl is null) yield break;
        if (tpl.TitleBand is { } t) yield return new("Título", t);
        if (tpl.HeaderBand is { } h) yield return new("Cabeçalho da página", h);
        foreach (var g in tpl.Groups)
            if (g.Header is { } gh) yield return new($"Grupo \"{g.BreakField}\" — cabeçalho", gh);
        if (tpl.DetailBand is { } d) yield return new("Detalhe", d);
        foreach (var g in tpl.Groups)
            if (g.Footer is { Elements.Count: > 0 } gf) yield return new($"Grupo \"{g.BreakField}\" — rodapé", gf);
        if (tpl.FooterBand is { } f) yield return new("Rodapé da página", f);
        if (tpl.SummaryBand is { } s) yield return new("Resumo", s);
    }

    IEnumerable<RbElement> Todos() => Secoes().SelectMany(s => s.Band.Elements);

    string Rotulo(RbElement el) => el switch
    {
        RbLabel l => Trunc(l.Text),
        RbDbText d => "⬚ " + d.DataField,
        RbDbMemo m => "▤ " + m.DataField,
        RbSystemVariable v => "⚙ " + v.VarType,
        RbImage => "🖼 imagem",
        RbShape => "▭",
        RbLine => "",
        _ => el.Name
    };

    static string Trunc(string s) => s.Length > 44 ? s[..44] + "…" : s;

    (double Left, double Top, double Width, double Height, bool Hidden) Eff(RbElement el)
    {
        if (overrides.TryGetValue(el.Name, out var o))
            return (o.LeftMm ?? el.LeftMm, o.TopMm ?? el.TopMm,
                    o.WidthMm ?? el.WidthMm, o.HeightMm ?? el.HeightMm, o.Hidden);
        return (el.LeftMm, el.TopMm, el.WidthMm, el.HeightMm, false);
    }

    void Merge(string name, Func<ElementOverride, ElementOverride> upd)
    {
        var cur = overrides.TryGetValue(name, out var o) ? o : new ElementOverride();
        overrides[name] = upd(cur);
    }

    void Selecionar(string name) => selecionado = name;

    void SetPos(ChangeEventArgs e, char campo)
    {
        var s = sel;
        if (s is null) return;
        var txt = e.Value?.ToString();
        if (!double.TryParse(txt, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var v)
            && !double.TryParse(txt, out v)) return;
        v = Round(v);
        Snapshot();
        Merge(s.Name, o => campo switch
        {
            'L' => o with { LeftMm = v },
            'T' => o with { TopMm = v },
            'W' => o with { WidthMm = v },
            'H' => o with { HeightMm = v },
            _ => o
        });
    }

    void ToggleHidden(ChangeEventArgs e)
    {
        var s = sel;
        if (s is null) return;
        var on = e.Value is bool bv && bv;
        Snapshot();
        Merge(s.Name, o => o with { Hidden = on });
    }

    void ResetarCampo(string name)
    {
        Snapshot();
        overrides.Remove(name);
    }

    void ResetarTudo()
    {
        Snapshot();
        overrides.Clear();
        Toasts.Info("Ajustes descartados (ainda não salvos).");
    }

    // ---- JSON ----
    void AbrirJson()
    {
        jsonErro = null;
        jsonText = LayoutOverridesJson.Serialize(overrides);
        jsonVisible = true;
    }

    void AplicarJson()
    {
        try
        {
            var novo = LayoutOverridesJson.Parse(jsonText);
            Snapshot();
            overrides.Clear();
            foreach (var kv in novo) overrides[kv.Key] = kv.Value;
            jsonErro = null;
            jsonVisible = false;
            Toasts.Success("JSON aplicado. Salve para persistir.");
        }
        catch (Exception ex)
        {
            jsonErro = "JSON inválido: " + ex.Message;
        }
    }

    // ---- salvar / preview ----
    async Task Salvar()
    {
        try
        {
            await Store.SaveLayoutAsync(codigo, overrides);
            if (previewUrl is not null) AtualizarPreview();
            Toasts.Success("Layout salvo!");
        }
        catch (Exception ex)
        {
            Toasts.Error("Erro ao salvar: " + ex.Message);
        }
    }

    string GetTeste(string name) => testeValores.TryGetValue(name, out var v) ? v : "";
    void SetTeste(string name, string? v) => testeValores[name] = v ?? "";

    void AtualizarPreview()
    {
        previewAberto = true;
        var qs = string.Join("&", parametros
            .Where(n => !string.IsNullOrWhiteSpace(GetTeste(n)))
            .Select(n => Uri.EscapeDataString(n) + "=" + Uri.EscapeDataString(GetTeste(n))));
        var baseUrl = $"/reports/{Uri.EscapeDataString(codigo)}/pdf";
        previewUrl = baseUrl + (qs.Length > 0 ? "?" + qs + "&" : "?") + "v=" + DateTime.Now.Ticks;
    }

    static double Round(double v) => Math.Round(v, 2);
    static string F(double mm) => mm.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string Px(double mm) => (mm * scale).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        try { if (module is not null) await module.DisposeAsync(); } catch { }
        selfRef?.Dispose();
    }
}
