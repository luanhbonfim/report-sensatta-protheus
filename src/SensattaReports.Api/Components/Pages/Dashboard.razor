@page "/admin"
@implements IDisposable
@inject ReportFileStore Store
@inject CallLogService Calls

<div class="page-head">
    <div>
        <h1>Dashboard</h1>
        <p class="muted">Visão geral do serviço de relatórios</p>
    </div>
    <a class="btn primary" href="/admin/importar">＋ Importar relatório</a>
</div>

<div class="kpis">
    <div class="kpi">
        <div class="kpi-val">@Store.ListImported().Count</div>
        <div class="kpi-lab">Relatórios ativos</div>
    </div>
    <div class="kpi">
        <div class="kpi-val">@Calls.Hoje</div>
        <div class="kpi-lab">Chamadas hoje</div>
    </div>
    <div class="kpi">
        <div class="kpi-val">@Calls.Total</div>
        <div class="kpi-lab">Chamadas no buffer</div>
    </div>
    <div class="kpi @(Calls.Erros > 0 ? "kpi-warn" : "")">
        <div class="kpi-val">@Calls.Erros</div>
        <div class="kpi-lab">Erros</div>
    </div>
</div>

<div class="section-head">
    <h2>Últimas chamadas do Protheus</h2>
    <a class="link" href="/admin/chamadas">Ver todas →</a>
</div>

@if (!Calls.Recent(8).Any())
{
    <div class="empty">Nenhuma chamada registrada ainda.</div>
}
else
{
    <table class="table">
        <thead><tr><th>Quando</th><th>Relatório</th><th>Formato</th><th>Status</th><th>Tempo</th></tr></thead>
        <tbody>
            @foreach (var c in Calls.Recent(8))
            {
                <tr>
                    <td>@c.When.ToString("dd/MM HH:mm:ss")</td>
                    <td class="mono">@c.Codigo</td>
                    <td>@c.Format</td>
                    <td><span class="pill @(c.Ok ? "pill-ok" : "pill-err")">@c.Status</span></td>
                    <td>@(c.Ms) ms</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    System.Timers.Timer? timer;

    protected override void OnInitialized()
    {
        timer = new System.Timers.Timer(5000) { AutoReset = true };
        timer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        timer.Start();
    }

    public void Dispose() => timer?.Dispose();
}
