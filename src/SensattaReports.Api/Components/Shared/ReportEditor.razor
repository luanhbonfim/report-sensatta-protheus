@inject IReportCatalog Catalog
@inject ReportFileStore Store
@inject IReportRepository Repo
@inject ToastService Toasts

<Modal @bind-Visible="visible" Title="@titulo">
    <div class="mb-3">
        <label class="form-label fw-semibold">Código (URL / pasta)</label>
        <input class="form-control" @bind="codigo" />
    </div>

    <div class="mb-2">
        <label class="form-label fw-semibold">SQL (com binds :nome)</label>
        <textarea class="form-control font-monospace" rows="7" @bind="sql"
                  placeholder="SELECT ... WHERE data >= :data_ini AND data <= :data_fim ..."></textarea>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted small">@parametros.Count parâmetro(s)</span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="Detectar"><i class="bi bi-search me-1"></i>Detectar</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => parametros.Add(new ParamVm())"><i class="bi bi-plus-lg me-1"></i>Parâmetro</button>
        </div>
    </div>

    @if (parametros.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead><tr><th>Bind</th><th>Tipo</th><th class="text-center">Obrig.</th><th>Rótulo</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in parametros)
                    {
                        <tr>
                            <td><input class="form-control form-control-sm" @bind="p.Name" /></td>
                            <td>
                                <select class="form-select form-select-sm" @bind="p.Type">
                                    @foreach (var t in Tipos) { <option value="@t">@t</option> }
                                </select>
                            </td>
                            <td class="text-center"><input class="form-check-input" type="checkbox" @bind="p.Required" /></td>
                            <td><input class="form-control form-control-sm" @bind="p.Label" /></td>
                            <td><button class="btn btn-sm btn-link text-danger p-0" @onclick="() => parametros.Remove(p)" title="Remover"><i class="bi bi-x-lg"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-outline-secondary" @onclick="() => visible = false">Cancelar</button>
        <button class="btn btn-primary" @onclick="Salvar" disabled="@(!PodeSalvar())"><i class="bi bi-save me-1"></i>Salvar</button>
    </div>

    @if (urlSalva is not null)
    {
        <div class="border-top mt-3 pt-3">
            <label class="form-label text-muted small mb-1">Endpoint (para o Protheus)</label>
            <div class="input-group input-group-sm mb-3">
                <input class="form-control font-monospace" readonly value="@urlSalva" />
                <a class="btn btn-outline-secondary" href="@urlSalva" target="_blank"><i class="bi bi-box-arrow-up-right"></i></a>
            </div>

            <label class="form-label text-muted small mb-1">Testar com valores</label>
            @foreach (var nomeParam in parametrosSalvos)
            {
                <input class="form-control form-control-sm mb-2" placeholder="@nomeParam"
                       @bind:get="GetTeste(nomeParam)" @bind:set="(v) => SetTeste(nomeParam, v)" />
            }
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-primary" href="@LinkTeste("pdf")" target="_blank"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
                <a class="btn btn-sm btn-success" href="@LinkTeste("xlsx")" target="_blank"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
            </div>
        </div>
    }
</Modal>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    class ParamVm
    {
        public string Name = "";
        public string Type = "String";
        public bool Required = true;
        public string? Label;
    }

    readonly string[] Tipos = ["String", "Integer", "Decimal", "Date", "DateTime"];

    bool visible;
    string nome = "";
    string codigo = "";
    string sql = "";
    List<ParamVm> parametros = new();

    string? urlSalva;
    List<string> parametrosSalvos = new();
    readonly Dictionary<string, string> testeValores = new();

    string titulo => string.IsNullOrWhiteSpace(nome) ? "Report" : $"Report — {nome}";

    public async Task OpenAsync(string name, string codigoInicial, bool imported)
    {
        nome = name; codigo = codigoInicial;
        sql = ""; parametros = new();
        urlSalva = null; parametrosSalvos = new(); testeValores.Clear();

        if (imported)
        {
            var def = await Repo.GetByCodigoAsync(codigoInicial);
            if (def is not null)
            {
                sql = def.Sql;
                parametros = def.Parametros
                    .Select(p => new ParamVm { Name = p.Name, Type = p.Type.ToString(), Required = p.Required, Label = p.Label })
                    .ToList();
            }
        }
        visible = true;
        StateHasChanged();
    }

    void Detectar()
    {
        parametros = BindDetector.Detect(sql)
            .Select(b => new ParamVm { Name = b, Type = BindDetector.GuessType(b).ToString(), Required = true })
            .ToList();
        Toasts.Info($"{parametros.Count} parâmetro(s) detectado(s).");
    }

    bool PodeSalvar() => !string.IsNullOrWhiteSpace(sql)
        && !string.IsNullOrWhiteSpace(string.IsNullOrWhiteSpace(codigo) ? nome : codigo);

    async Task Salvar()
    {
        var cod = Slug.From(string.IsNullOrWhiteSpace(codigo) ? nome : codigo);
        if (cod.Length == 0) { Toasts.Error("Código/nome inválido."); return; }
        if (string.IsNullOrWhiteSpace(sql)) { Toasts.Error("Informe o SQL."); return; }

        var rtm = await Catalog.GetTemplateAsync(nome);
        if (string.IsNullOrWhiteSpace(rtm)) rtm = (await Repo.GetByCodigoAsync(cod))?.TemplateRtm;
        if (string.IsNullOrWhiteSpace(rtm)) { Toasts.Error("Template (.rtm) não encontrado."); return; }

        var ps = parametros
            .Where(p => !string.IsNullOrWhiteSpace(p.Name))
            .Select(p => new ReportParameter
            {
                Name = p.Name,
                Type = Enum.TryParse<ReportParameterType>(p.Type, true, out var t) ? t : ReportParameterType.String,
                Required = p.Required,
                Label = string.IsNullOrWhiteSpace(p.Label) ? null : p.Label
            })
            .ToList();

        try
        {
            await Store.SaveAsync(cod, string.IsNullOrWhiteSpace(nome) ? cod : nome, sql, rtm!, ps);
        }
        catch (Exception ex)
        {
            Toasts.Error("Erro ao salvar: " + ex.Message);
            return;
        }

        codigo = cod;
        urlSalva = $"/reports/{cod}/pdf";
        parametrosSalvos = ps.Select(p => p.Name).ToList();
        testeValores.Clear();
        foreach (var n in parametrosSalvos) testeValores[n] = "";

        Toasts.Success($"Report \"{cod}\" salvo!");
        await OnSaved.InvokeAsync();
    }

    string GetTeste(string name) => testeValores.TryGetValue(name, out var v) ? v : "";
    void SetTeste(string name, string? value) => testeValores[name] = value ?? "";

    string LinkTeste(string fmt)
    {
        var qs = string.Join("&", parametrosSalvos
            .Where(n => testeValores.TryGetValue(n, out var v) && !string.IsNullOrWhiteSpace(v))
            .Select(n => Uri.EscapeDataString(n) + "=" + Uri.EscapeDataString(testeValores[n])));
        return $"/reports/{Uri.EscapeDataString(codigo)}/{fmt}" + (qs.Length > 0 ? "?" + qs : "");
    }
}
