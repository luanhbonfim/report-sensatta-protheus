@if (Visible)
{
    <div class="rp-modal-backdrop" @onclick="Backdrop">
        <div class="rp-modal" @onclick:stopPropagation="true">
            <div class="rp-modal-head">
                <h5>@Title</h5>
                <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="Fechar"></button>
            </div>
            <div class="rp-modal-body">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    async Task CloseAsync() => await VisibleChanged.InvokeAsync(false);

    async Task Backdrop()
    {
        if (CloseOnBackdrop) await CloseAsync();
    }
}
