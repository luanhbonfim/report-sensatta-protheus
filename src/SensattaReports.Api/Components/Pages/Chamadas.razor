@page "/admin/chamadas"
@implements IDisposable
@inject CallLogService Calls

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Chamadas do Protheus</h4>
        <div class="text-muted small">Histórico das requisições aos relatórios · atualiza sozinho</div>
    </div>
    <span class="badge text-bg-light"><i class="bi bi-arrow-repeat me-1"></i>ao vivo</span>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Calls.Recent(200).Any())
        {
            <div class="p-4 text-center text-muted">Nenhuma chamada registrada ainda. As requisições do Protheus aparecem aqui.</div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th class="ps-3">Quando</th><th>Relatório</th><th>Formato</th><th>Status</th><th>Tempo</th><th>Parâmetros</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Calls.Recent(200))
                    {
                        <tr>
                            <td class="ps-3">@c.When.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="fw-semibold">@c.Codigo</td>
                            <td><span class="badge text-bg-light">@c.Format</span></td>
                            <td>
                                @if (c.Ok) { <span class="badge text-bg-success">@c.Status</span> }
                                else { <span class="badge text-bg-danger">@c.Status</span> }
                            </td>
                            <td>@(c.Ms) ms</td>
                            <td class="text-muted small font-monospace">@c.Query</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    System.Timers.Timer? timer;

    protected override void OnInitialized()
    {
        timer = new System.Timers.Timer(4000) { AutoReset = true };
        timer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        timer.Start();
    }

    public void Dispose() => timer?.Dispose();
}
