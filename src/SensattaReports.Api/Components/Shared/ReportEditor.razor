@inject IReportCatalog Catalog
@inject ReportFileStore Store
@inject IReportRepository Repo
@inject ToastService Toasts

<Modal @bind-Visible="visible" Title="@titulo">
    <div class="form">
        <label>Código (URL / pasta)</label>
        <input class="in" @bind="codigo" />

        <label>SQL (com binds :nome)</label>
        <textarea class="in ta" @bind="sql" placeholder="SELECT ... WHERE data >= :data_ini AND data <= :data_fim ..."></textarea>

        <div class="row between mt">
            <span class="muted small">@parametros.Count parâmetro(s)</span>
            <div class="row">
                <button class="btn ghost sm" @onclick="Detectar">🔍 Detectar</button>
                <button class="btn ghost sm" @onclick="() => parametros.Add(new ParamVm())">+ Parâmetro</button>
            </div>
        </div>

        @if (parametros.Count > 0)
        {
            <table class="table mt">
                <thead><tr><th>Bind</th><th>Tipo</th><th>Obrig.</th><th>Rótulo</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in parametros)
                    {
                        <tr>
                            <td><input class="in" @bind="p.Name" /></td>
                            <td>
                                <select class="in" @bind="p.Type">
                                    @foreach (var t in Tipos) { <option value="@t">@t</option> }
                                </select>
                            </td>
                            <td class="center"><input type="checkbox" @bind="p.Required" /></td>
                            <td><input class="in" @bind="p.Label" /></td>
                            <td><button class="icon-btn" @onclick="() => parametros.Remove(p)" title="Remover">✕</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="modal-actions">
            <button class="btn" @onclick="() => visible = false">Cancelar</button>
            <button class="btn primary" @onclick="Salvar" disabled="@(!PodeSalvar())">💾 Salvar</button>
        </div>

        @if (urlSalva is not null)
        {
            <div class="saved">
                <div class="muted small">Endpoint (para o Protheus)</div>
                <div class="row">
                    <input class="in mono" readonly value="@urlSalva" />
                    <a class="btn ghost" href="@urlSalva" target="_blank">Abrir</a>
                </div>

                <div class="test">
                    <div class="muted small mt">Testar com valores:</div>
                    @foreach (var nomeParam in parametrosSalvos)
                    {
                        <input class="in mt" placeholder="@nomeParam"
                               @bind:get="GetTeste(nomeParam)" @bind:set="(v) => SetTeste(nomeParam, v)" />
                    }
                    <div class="row mt">
                        <a class="btn" href="@LinkTeste("pdf")" target="_blank">📄 Gerar PDF</a>
                        <a class="btn" href="@LinkTeste("xlsx")" target="_blank">📊 Gerar Excel</a>
                    </div>
                </div>
            </div>
        }
    </div>
</Modal>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    class ParamVm
    {
        public string Name = "";
        public string Type = "String";
        public bool Required = true;
        public string? Label;
    }

    readonly string[] Tipos = ["String", "Integer", "Decimal", "Date", "DateTime"];

    bool visible;
    string nome = "";
    string codigo = "";
    string sql = "";
    List<ParamVm> parametros = new();

    string? urlSalva;
    List<string> parametrosSalvos = new();
    readonly Dictionary<string, string> testeValores = new();

    string titulo => string.IsNullOrWhiteSpace(nome) ? "Report" : $"Report — {nome}";

    public async Task OpenAsync(string name, string codigoInicial, bool imported)
    {
        nome = name; codigo = codigoInicial;
        sql = ""; parametros = new();
        urlSalva = null; parametrosSalvos = new(); testeValores.Clear();

        if (imported)
        {
            var def = await Repo.GetByCodigoAsync(codigoInicial);
            if (def is not null)
            {
                sql = def.Sql;
                parametros = def.Parametros
                    .Select(p => new ParamVm { Name = p.Name, Type = p.Type.ToString(), Required = p.Required, Label = p.Label })
                    .ToList();
            }
        }
        visible = true;
        StateHasChanged();
    }

    void Detectar()
    {
        parametros = BindDetector.Detect(sql)
            .Select(b => new ParamVm { Name = b, Type = BindDetector.GuessType(b).ToString(), Required = true })
            .ToList();
        Toasts.Info($"{parametros.Count} parâmetro(s) detectado(s).");
    }

    bool PodeSalvar() => !string.IsNullOrWhiteSpace(sql)
        && !string.IsNullOrWhiteSpace(string.IsNullOrWhiteSpace(codigo) ? nome : codigo);

    async Task Salvar()
    {
        var cod = Slug.From(string.IsNullOrWhiteSpace(codigo) ? nome : codigo);
        if (cod.Length == 0) { Toasts.Error("Código/nome inválido."); return; }
        if (string.IsNullOrWhiteSpace(sql)) { Toasts.Error("Informe o SQL."); return; }

        var rtm = await Catalog.GetTemplateAsync(nome);
        if (string.IsNullOrWhiteSpace(rtm)) rtm = (await Repo.GetByCodigoAsync(cod))?.TemplateRtm;
        if (string.IsNullOrWhiteSpace(rtm)) { Toasts.Error("Template (.rtm) não encontrado."); return; }

        var ps = parametros
            .Where(p => !string.IsNullOrWhiteSpace(p.Name))
            .Select(p => new ReportParameter
            {
                Name = p.Name,
                Type = Enum.TryParse<ReportParameterType>(p.Type, true, out var t) ? t : ReportParameterType.String,
                Required = p.Required,
                Label = string.IsNullOrWhiteSpace(p.Label) ? null : p.Label
            })
            .ToList();

        try
        {
            await Store.SaveAsync(cod, string.IsNullOrWhiteSpace(nome) ? cod : nome, sql, rtm!, ps);
        }
        catch (Exception ex)
        {
            Toasts.Error("Erro ao salvar: " + ex.Message);
            return;
        }

        codigo = cod;
        urlSalva = $"/reports/{cod}/pdf";
        parametrosSalvos = ps.Select(p => p.Name).ToList();
        testeValores.Clear();
        foreach (var n in parametrosSalvos) testeValores[n] = "";

        Toasts.Success($"Report \"{cod}\" salvo!");
        await OnSaved.InvokeAsync();
    }

    string GetTeste(string name) => testeValores.TryGetValue(name, out var v) ? v : "";
    void SetTeste(string name, string? value) => testeValores[name] = value ?? "";

    string LinkTeste(string fmt)
    {
        var qs = string.Join("&", parametrosSalvos
            .Where(n => testeValores.TryGetValue(n, out var v) && !string.IsNullOrWhiteSpace(v))
            .Select(n => Uri.EscapeDataString(n) + "=" + Uri.EscapeDataString(testeValores[n])));
        return $"/reports/{Uri.EscapeDataString(codigo)}/{fmt}" + (qs.Length > 0 ? "?" + qs : "");
    }
}
