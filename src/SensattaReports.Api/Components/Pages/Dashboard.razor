@page "/admin"
@implements IDisposable
@inject ReportFileStore Store
@inject CallLogService Calls

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Dashboard</h4>
        <div class="text-muted small">Visão geral do serviço de relatórios</div>
    </div>
    <a class="btn btn-primary" href="/admin/importar"><i class="bi bi-plus-circle me-1"></i>Importar relatório</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card" style="background:#7f1810">
            <div class="metric-value">@Store.ListImported().Count</div>
            <div class="metric-label">Relatórios ativos</div>
            <i class="bi bi-file-earmark-text metric-ic"></i>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card" style="background:#0d6efd">
            <div class="metric-value">@Calls.Hoje</div>
            <div class="metric-label">Chamadas hoje</div>
            <i class="bi bi-activity metric-ic"></i>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card" style="background:#6c757d">
            <div class="metric-value">@Calls.Total</div>
            <div class="metric-label">Chamadas (buffer)</div>
            <i class="bi bi-bar-chart metric-ic"></i>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card" style="background:@ErroBg()">
            <div class="metric-value">@Calls.Erros</div>
            <div class="metric-label">Erros</div>
            <i class="bi bi-exclamation-triangle metric-ic"></i>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Últimas chamadas do Protheus</span>
        <a class="small text-decoration-none" href="/admin/chamadas">Ver todas →</a>
    </div>
    <div class="card-body p-0">
        @if (!Calls.Recent(8).Any())
        {
            <div class="p-4 text-center text-muted">Nenhuma chamada registrada ainda.</div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th class="ps-3">Quando</th><th>Relatório</th><th>Formato</th><th>Status</th><th>Tempo</th></tr></thead>
                <tbody>
                    @foreach (var c in Calls.Recent(8))
                    {
                        <tr>
                            <td class="ps-3">@c.When.ToString("dd/MM HH:mm:ss")</td>
                            <td class="fw-semibold">@c.Codigo</td>
                            <td><span class="badge text-bg-light">@c.Format</span></td>
                            <td>
                                @if (c.Ok) { <span class="badge text-bg-success">@c.Status</span> }
                                else { <span class="badge text-bg-danger">@c.Status</span> }
                            </td>
                            <td>@(c.Ms) ms</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    System.Timers.Timer? timer;

    protected override void OnInitialized()
    {
        timer = new System.Timers.Timer(5000) { AutoReset = true };
        timer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        timer.Start();
    }

    string ErroBg() => Calls.Erros > 0 ? "#dc3545" : "#198754";

    public void Dispose() => timer?.Dispose();
}
