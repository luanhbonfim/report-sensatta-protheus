<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Nome do servico quando rodar como Windows Service / systemd -->
    <AssemblyName>SensattaReports.Api</AssemblyName>
    <!-- API headless: sem wwwroot / arquivos estaticos (evita o StaticWebAssets
         procurar a pasta wwwroot inexistente no startup). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permite rodar como Windows Service -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- Permite rodar como daemon systemd no Linux -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <!-- Fixa versao corrigida do CVE-2026-84008 (dep. transitiva do driver Oracle) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Autenticacao JWT Bearer (Protheus e painel externo) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!-- Documentacao OpenAPI (pagina /docs + /openapi/v1.json) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SensattaReports.Core\SensattaReports.Core.csproj" />
    <ProjectReference Include="..\SensattaReports.ReportBuilder\SensattaReports.ReportBuilder.csproj" />
    <ProjectReference Include="..\SensattaReports.Data\SensattaReports.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copia a pasta de reports (sql/rtm/params) para a saida, em dev e publish.
         Assim os arquivos acompanham o servico onde quer que ele rode. -->
    <Content Include="../../reports/**/*"
             Link="reports/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
